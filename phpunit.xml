<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         displayDetailsOnTestsThatTriggerWarnings="true">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- force="true": Werte aus der Shell oder .env dürfen Tests nie auf echte Dienste umleiten. -->
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="CACHE_DRIVER" value="array" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="MAIL_DRIVER" value="array" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <!-- Tests laufen nie gegen die Dev-/Prod-Datenbank, siehe Tests\TestCase::beforeRefreshingDatabase() -->
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="DATABASE_URL" value="" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <!-- Zweite Verbindung mysql_info (Personendaten der Gesundheitsblätter) -->
        <env name="DB_CONNECTION_INFO" value="sqlite" force="true"/>
        <env name="DB_DATABASE_INFO" value=":memory:" force="true"/>
        <!-- Ohne Absender schlägt jeder Mailversand fehl (.env.example hat MAIL_FROM_ADDRESS=null) -->
        <env name="MAIL_FROM_ADDRESS" value="test@example.com" force="true"/>
        <!-- PermissionRoleSeeder legt den Admin mit diesem Passwort an -->
        <env name="ADMIN_PASSWORD" value="password" force="true"/>
    </php>
</phpunit>
